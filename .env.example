# Copy this file to ".env" and fill it in. Never share .env.

# Gemini key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Optional: Google Sheet link ending in /export?format=csv (sheet shared as "anyone with the link")
SHEET_CSV_URL=

# Optional: your chat ID for handoff alerts (send /myid to the bot)
ADMIN_CHAT_ID=
